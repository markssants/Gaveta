{
  "manifest_version": 3,
  "name": "Gaveta",
  "description": "Guarde a aba atual, ou todas as abas da janela, no seu Gaveta.",
  "version": "1.1.0",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Guardar no Gaveta",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "commands": {
    "save-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Guardar a aba atual no Gaveta"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gaveta@extensao.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
